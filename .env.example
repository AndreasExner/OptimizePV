# evcc
EVCC_URL=http://localhost:7070
# Pfad zur evcc SQLite-DB (OPTIONAL – nur bei lokalem Zugriff auf evcc.db)
# Bei Remote-Installationen (z.B. HA OS) nicht nutzbar, REST API reicht aus.
# EVCC_DB_PATH=/path/to/evcc.db

# Standort (für Wetter-API)
LATITUDE=51.1657
LONGITUDE=10.4515

# Strompreis-API (optional, nur wenn Tibber genutzt wird)
# TIBBER_TOKEN=your_tibber_api_token
